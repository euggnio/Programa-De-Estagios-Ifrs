# =============================================================
#  COMO USAR
#  1) cp .env.example .env
#  2) ajuste os valores abaixo (os exemplos já funcionam em uma
#     instalação nova - pode manter como estão e trocar depois)
#  3) docker compose up -d --build
#
#  Este arquivo é só um modelo: o git ignora o .env de verdade,
#  então em outra máquina você precisa criá-lo novamente.
# =============================================================

# --- MySQL ---------------------------------------------------
# Usados pelo container MySQL e pelo Spring (sempre os mesmos 4).
# Em produção troque as senhas por aleatórias: openssl rand -hex 16
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=sistemaestagios
MYSQL_USER=estagio
MYSQL_PASSWORD=estagio123

# --- JWT -----------------------------------------------------
# Assina os tokens de login. Precisa ter no mínimo 32 caracteres.
# Gerar um aleatório: openssl rand -hex 32
JWT_SECRET=0123456789abcdef0123456789abcdef

# --- Google Drive --------------------------------------------
# OBRIGATÓRIO: id da pasta raiz onde as pastas de curso e de aluno
# são criadas no Drive.
#   - Como pegar: abra a pasta no Drive e copie o trecho da URL
#     https://drive.google.com/drive/folders/<ESTE_BLOCO_E_O_ID>
#   - A pasta precisa estar compartilhada (com edição) com a conta
#     Google usada pelo sistema (naoresponda_sistema@restinga.ifrs.edu.br).
#   - Sem esta chave os deferimentos respondem HTTP 503 com a mensagem
#     de "pasta raiz não configurada" (a solicitação NÃO fica presa em
#     "Processando").
# Exemplo (substitua pelo id da sua pasta):
GOOGLE_DRIVE_ROOT_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789abcd

# Opcional: onde o backend lê o client OAuth (clientKey.json) em runtime.
# Padrão: classpath:clientKey.json = arquivo dentro do app.jar
#         (para trocar o JSON é preciso refazer o build da imagem).
# Para ler um arquivo fora do jar - ex.: keys/clientKey.json, que já é
# ignorado pelo git - descomente a linha abaixo (relativo a /app):
# GOOGLE_DRIVE_CREDENTIALS_PATH=keys/clientKey.json

# --- Frontend ------------------------------------------------
# URL do front usada nos links dos e-mails enviados pelo sistema.
# Front na porta 80 (padrão): http://localhost
FRONTEND_URL=http://localhost
# Obs.: a porta do nginx do front é definida no .env do repositório
#       do front (DEV-II-FrontEnd/.env), variável FRONTEND_PORT=80
