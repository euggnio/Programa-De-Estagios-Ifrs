# --- MySQL ---
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD
MYSQL_DATABASE=sistemaestagios
MYSQL_USER=CHANGE_ME_APP_USERNAME
MYSQL_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD

# --- JWT ---
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_RANDOM_SECRET

